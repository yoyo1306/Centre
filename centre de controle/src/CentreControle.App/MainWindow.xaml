<Window
    x:Class="CentreControle.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Centre de contrôle">

    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="RootGrid_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée Windows 11 -->
        <Grid Grid.Row="0" Padding="14,0,142,0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Zone draggable -->
            <Grid x:Name="AppTitleBar" Grid.Column="0" Background="Transparent" VerticalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Image x:Name="TitleIcon" Width="18" Height="18" />
                    <TextBlock Text="Centre de contrôle"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               VerticalAlignment="Center" />
                    <Border x:Name="StatusPill"
                            CornerRadius="10"
                            Padding="8,2"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock x:Name="StatusLabel"
                                       Text="Arrêté"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Button x:Name="ThemeModeBtn"
                    Grid.Column="1"
                    Click="ThemeModeBtn_Click"
                    Height="30"
                    Padding="9,0"
                    CornerRadius="6"
                    ToolTipService.ToolTip="Basculer Clair / Sombre">
                <FontIcon x:Name="ThemeModeIcon" FontFamily="Segoe Fluent Icons" Glyph="&#xE708;" FontSize="13" />
            </Button>

            <ToggleButton x:Name="OptionsToggleBtn"
                          Grid.Column="2"
                          Click="OptionsToggleBtn_Click"
                          Height="30"
                          Padding="10,0"
                          CornerRadius="6"
                          ToolTipService.ToolTip="Options du moniteur et démarrage">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="13" />
                    <TextBlock Text="Options" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </ToggleButton>
        </Grid>

        <!-- Contenu principal -->
        <Grid Grid.Row="1" Padding="14,4,14,8" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Carte Luminosité écran 480x320 -->
            <Border Grid.Row="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE706;" FontSize="14"
                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="Luminosité · Écran 480×320"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                        </StackPanel>
                        <TextBlock x:Name="BrightValueText"
                                   Text="—"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>

                    <Grid x:Name="BrightButtonsGrid" Grid.Row="1" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Grid>
            </Border>

            <!-- En-tête + filtres de thèmes -->
            <Grid Grid.Row="1">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Thèmes" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="15" />
                    <TextBlock x:Name="ThemeCountText"
                               Text="(20)"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button x:Name="FilterAllBtn" Content="Tous" Click="FilterBtn_Click" Tag="all" Padding="10,4" FontSize="12" CornerRadius="6" />
                    <Button x:Name="FilterGreenBtn" Content="Verts (8)" Click="FilterBtn_Click" Tag="green" Padding="10,4" FontSize="12" CornerRadius="6" />
                    <Button x:Name="FilterColorBtn" Content="Couleurs (12)" Click="FilterBtn_Click" Tag="color" Padding="10,4" FontSize="12" CornerRadius="6" />
                </StackPanel>
            </Grid>

            <!-- Grille scrollable de vignettes 480x320 -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <Grid x:Name="ThemesHostGrid" ColumnSpacing="10" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>

            <!-- Panneau Options (tiroir WinUI 3 style Paramètres Windows 11) -->
            <Border x:Name="OptionsOverlay"
                    Grid.RowSpan="3"
                    Visibility="Collapsed"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Translation="0,0,32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="16" />
                                <TextBlock Text="Options" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                            </StackPanel>
                            <Button Content="Fermer"
                                    Click="CloseOptionsBtn_Click"
                                    HorizontalAlignment="Right"
                                    Padding="12,4"
                                    CornerRadius="6" />
                        </Grid>

                        <!-- Carte 1 : Démarrage Windows -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Lancer le moniteur au démarrage" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="StartupDescText"
                                               Text="Tâche planifiée Windows « SensorPanel » (droits admin)"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle"
                                              HorizontalAlignment="Right"
                                              OnContent="Activé"
                                              OffContent="Désactivé"
                                              Toggled="StartupToggle_Toggled" />
                            </Grid>
                        </Border>

                        <!-- Carte 2 : Vitesse de mise à jour -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <StackPanel Spacing="8">
                                <TextBlock Text="Vitesse de mise à jour" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid x:Name="SpeedButtonsGrid" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Carte 3 : Moniteur 480x320 -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Moniteur (480×320)" Style="{StaticResource BodyStrongTextBlockStyle}" />

                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Positionnement automatique" Style="{StaticResource BodyTextBlockStyle}" />
                                        <TextBlock Text="Replace le moniteur sur le petit écran 480×320"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button x:Name="RecenterBtn"
                                            Click="RecenterBtn_Click"
                                            HorizontalAlignment="Right"
                                            CornerRadius="6"
                                            Padding="12,6">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE7F4;" FontSize="13" />
                                            <TextBlock Text="Recentrer" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <MenuFlyoutSeparator />

                                <Grid>
                                    <TextBlock Text="Verrouiller la position (sans bordure)" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="LockToggle"
                                                  HorizontalAlignment="Right"
                                                  OnContent="Verrouillé"
                                                  OffContent="Libre"
                                                  Toggled="LockToggle_Toggled" />
                                </Grid>

                                <Grid>
                                    <TextBlock Text="Toujours au premier plan" VerticalAlignment="Center" />
                                    <ToggleSwitch x:Name="TopmostToggle"
                                                  HorizontalAlignment="Right"
                                                  OnContent="Oui"
                                                  OffContent="Non"
                                                  Toggled="TopmostToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Carte 4 : Pilote capteurs CPU (PawnIO) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14,10">
                            <Grid>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Pilote température CPU (PawnIO)" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="PawnIoStatusText"
                                               Text="Vérification…"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Button x:Name="InstallPawnIoBtn"
                                        Content="Installer"
                                        Click="InstallPawnIoBtn_Click"
                                        HorizontalAlignment="Right"
                                        Visibility="Collapsed"
                                        CornerRadius="6" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="VersionFooterText"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Pied de fenêtre (actions principales) -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="FlashText"
                           Grid.Column="0"
                           Text="Prêt"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <Button x:Name="StopBtn"
                        Grid.Column="1"
                        Click="StopBtn_Click"
                        Padding="14,7"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE71A;" FontSize="12" />
                        <TextBlock Text="Arrêter" />
                    </StackPanel>
                </Button>

                <Button x:Name="ApplyBtn"
                        Grid.Column="2"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="ApplyBtn_Click"
                        Padding="18,7"
                        CornerRadius="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE73E;" FontSize="12" />
                        <TextBlock Text="Appliquer" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
